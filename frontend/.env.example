# Copy to .env.local for local development. Both values are public (row-level
# security in supabase/schema.sql protects the data). Without them, sign-in is off.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: call the backend directly instead of through the Vite proxy
# VITE_API_BASE_URL=https://ai-resume-analyzer-xb45.onrender.com
